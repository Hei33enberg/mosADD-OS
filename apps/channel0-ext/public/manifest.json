{
  "manifest_version": 3,
  "name": "channel 0 [mIRC] — with mosadd inside",
  "short_name": "channel 0",
  "description": "Anonymous live chat scoped to the domain you're on. Everyone on the same site, one room. Powered by mosadd.",
  "version": "0.1.0",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "channel 0 — open chat for this domain",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
