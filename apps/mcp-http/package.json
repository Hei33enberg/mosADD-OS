    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@mosadd/mcp": "3.0.0-alpha.32"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "hono": ">=4.12.25"
  },
  "engines": {
    "node": ">=18"
  }
}
