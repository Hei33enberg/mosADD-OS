{
  "name": "@mosadd/mcp-http",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hosted MCP gateway (Streamable HTTP) for mcp.mosadd.com — serves @mosadd/mcp over HTTP with per-request, multi-tenant auth (Bearer mosadd_sk_live_… -> hub-key-exchange).",
