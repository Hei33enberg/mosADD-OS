{
  "name": "@mosadd/providers",
  "version": "3.0.0-alpha.26",
  "description": "Provider contracts for mosadd: transport-agnostic interfaces for voice (mTALK PTT floor) and DM delivery. Interfaces only today — vendor adapters land per-provider.",
  "homepage": "https://github.com/Hei33enberg/mosadd-os/tree/main/packages/providers",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hei33enberg/mosadd-os.git",
    "directory": "packages/providers"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mosadd/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
