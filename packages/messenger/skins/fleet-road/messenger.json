{
  "$schema": "https://mosadd.dev/schema/messenger/1.json",
  "format": "mosadd.messenger",
  "formatVersion": 1,
  "id": "skin-fleet-road",
  "revision": 1,
  "appVersion": "1.0.0",
  "template": "logistics-fleet@1",
  "brand": {
    "name": "Fleet Desk",
    "shortName": "FleetDesk",
    "description": "Dispatch channels, push-to-talk with drivers and an agent that chases delivery status.",
    "icon": "assets/icon-1024.png",
    "languages": [
      "en"
    ],
    "defaultLanguage": "en",
    "privacyPolicy": "https://example.org/privacy",
    "poweredBy": "about"
  },
  "core": {
    "line": "mosadd-core@1",
    "channel": "stable"
  },
  "blocks": [
    {
      "id": "identity",
      "enabled": true,
      "settings": {
        "login": [
          "email-code",
          "device-key"
        ],
        "namespace": "fleetdesk",
        "joining": "invite-only"
      }
    },
    {
      "id": "mtalk",
      "enabled": true,
      "settings": {
        "button": "large-bottom",
        "queue": true,
        "recordings": true,
        "transcripts": true,
        "maxSeconds": 60,
        "inChannels": true
      }
    },
    {
      "id": "mirc",
      "enabled": true,
      "settings": {
        "startChannels": [
          "#dispatch",
          "#depot",
          "#delays"
        ],
        "whoCreatesChannels": "admins"
      }
    },
    {
      "id": "mdm",
      "enabled": true,
      "settings": {
        "calls": true,
        "files": true,
        "disappearingHours": 0
      }
    },
    {
      "id": "madd",
      "enabled": true,
      "settings": {
        "homeAgents": [
          {
            "name": "Router",
            "role": "Collects delivery status from drivers by voice or text, flags delays on #delays, answers depot questions",
            "model": "mosadd/flash",
            "voice": "clear-en"
          }
        ],
        "usersBringOwnAgents": false
      }
    },
    {
      "id": "mkeeper",
      "enabled": true,
      "settings": {
        "jobs": [
          {
            "name": "morning-brief",
            "cron": "30 5 * * 1-6",
            "does": "Router posts today's route list and known delays on #dispatch"
          }
        ]
      }
    },
    {
      "id": "mrag",
      "enabled": true,
      "settings": {
        "scope": "team-channels",
        "limitMbPerUser": 100
      }
    },
    {
      "id": "mayl",
      "enabled": false
    },
    {
      "id": "murl",
      "enabled": false
    },
    {
      "id": "offline",
      "enabled": true,
      "settings": {
        "storeAndForward": true,
        "localNetwork": false,
        "bluetooth": false,
        "lora": false
      }
    }
  ],
  "layout": {
    "tabs": [
      "mtalk",
      "mirc",
      "mdm",
      "madd"
    ],
    "home": "mirc"
  },
  "theme": {
    "id": "fleet-road",
    "version": "1.0.0",
    "base": "mosadd-august",
    "defaultMode": "dark",
    "modes": [
      "dark",
      "light"
    ],
    "tokens": {
      "dark": {
        "background": "#0a1416",
        "surface": "#112024",
        "border": "#24424a",
        "text": "#eef2f7",
        "textMuted": "#9db8bd",
        "accent": "#2bd0c0",
        "onAccent": "#02201d",
        "warning": "#f5a524",
        "error": "#ff6b6b",
        "pttTransmit": "#ff4d4f",
        "pttListen": "#2ecc71"
      },
      "light": {
        "background": "#f3f8f8",
        "surface": "#ffffff",
        "border": "#cbd5e1",
        "text": "#0f172a",
        "textMuted": "#475569",
        "accent": "#0b6b63",
        "onAccent": "#ffffff",
        "warning": "#a16207",
        "error": "#b91c1c",
        "pttTransmit": "#9b1515",
        "pttListen": "#15803d"
      }
    },
    "fonts": {
      "text": "IBM Plex Sans",
      "headings": "IBM Plex Sans"
    },
    "radius": "soft",
    "density": "comfortable",
    "backdrop": {
      "kind": "lidar"
    }
  },
  "releases": {
    "android": {
      "enabled": true,
      "package": "org.example.fleetdesk",
      "shell": "bundled",
      "signing": "creator-key",
      "autoSignSecurityPatches": true,
      "channels": [
        "direct-apk",
        "mosadd-store"
      ],
      "push": "unifiedpush"
    },
    "desktop": {
      "enabled": true,
      "systems": [
        "windows",
        "linux"
      ],
      "signing": "mosadd"
    },
    "web": {
      "enabled": true,
      "address": "fleetdesk",
      "customDomain": null
    },
    "channel": "beta"
  },
  "instance": {
    "hosting": "mosadd",
    "network": {
      "listedInMosaddDirectory": false
    },
    "cloudServices": [
      "madd",
      "ptt-transcripts"
    ]
  },
  "budget": {
    "monthlyUsd": 200,
    "overBudget": "text-only"
  },
  "privacy": {
    "telemetry": "none",
    "crashReports": "opt-in"
  }
}
