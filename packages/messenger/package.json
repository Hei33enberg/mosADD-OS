{
  "name": "@mosadd/messenger",
  "version": "0.1.0",
  "description": "The messenger.json format for mosADD Studio: Zod schema, JSON Schema, validator (shape, consistency, WCAG contrast, honesty and trademark), migrations and CLI.",
  "homepage": "https://github.com/Hei33enberg/mosadd-os/tree/main/packages/messenger",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hei33enberg/mosadd-os.git",
    "directory": "packages/messenger"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mosadd-messenger": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema.json": "./schema/messenger-1.json"
  },
  "files": [
    "dist",
    "src",
    "schema",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean",
    "schema": "node scripts/emit-schema.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "mosadd",
    "messenger",
    "white-label",
    "schema",
    "zod",
    "wcag"
  ],
  "engines": {
    "node": ">=18"
  }
}
