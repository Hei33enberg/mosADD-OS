{
  "name": "@mosadd/agent",
  "version": "3.0.0-alpha.1",
  "description": "The mosadd agent runner — turn a Supabase identity + an LLM key into a live mosadd contact that reads and replies to DMs. One command, your brand, no Hermes branding on the user's first install. Wraps the @mosadd/mcp tool handlers directly (no MCP-protocol hallucination); LLM only writes the reply text.",
  "homepage": "https://github.com/Hei33enberg/mosADD-OS/tree/main/packages/agent",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hei33enberg/mosADD-OS.git",
    "directory": "packages/agent"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "mosadd-agent": "./dist/bin/agent.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin/agent.ts --format esm --dts --clean --shims",
    "dev": "tsx src/bin/agent.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@mosadd/mcp": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "mosadd",
    "agent",
    "ai-agent",
    "communication",
    "messaging",
    "claude",
    "openrouter"
  ],
  "engines": {
    "node": ">=18"
  }
}
