{
  "name": "@mosadd/threat-engine",
  "version": "3.0.0-alpha.26",
  "description": "Threat-event taxonomy (193 canonical events) + scoring + pure defensive-decision engine for mosadd — the classification layer behind mLIDAR and the Irondome security pillar.",
  "homepage": "https://github.com/Hei33enberg/mosadd-os/tree/main/packages/threat-engine",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hei33enberg/mosadd-os.git",
    "directory": "packages/threat-engine"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
