{
  "name": "@m0ssad/mcp",
  "version": "3.0.0-alpha.0",
  "description": "Model Context Protocol server for mosadd. Exposes m* OS modules (mDM, mTALK, mAIL, mCALL, mIRC, mIRL, mROOM, and bridges) as MCP tools to any agent runtime (Claude Code, Cursor, Windsurf, Cline, ChatGPT Apps, Lovable, Bolt, Goose, Manus, custom).",
  "homepage": "https://github.com/mosadd/os/tree/main/packages/mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mosadd/os.git",
    "directory": "packages/mcp"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "mosadd-mcp": "./dist/bin/mcp.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin/mcp.ts --format esm --dts --clean --shims",
    "dev": "tsx src/bin/mcp.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@m0ssad/protocol": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "mosadd",
    "mcp",
    "model-context-protocol",
    "agent",
    "claude",
    "cursor",
    "anthropic",
    "communication",
    "messaging"
  ]
}
