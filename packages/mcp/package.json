{
  "name": "@mosadd/mcp",
  "version": "3.0.0-alpha.25",
  "mcpName": "io.github.hei33enberg/mosadd-mcp",
  "description": "Model Context Protocol server for mosadd. Exposes 4 modules (mDM, mIRC, mURL, mAYL) and capabilities (mTALK, mRAG) plus comms agent-actions — 74 tools (mp0st_* aliases through alpha.26) — to any agent runtime (Claude Code, Cursor, Windsurf, Cline, ChatGPT Apps, Lovable, Bolt, Goose, Manus, custom).",
  "homepage": "https://github.com/Hei33enberg/mosADD-OS/tree/main/packages/mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hei33enberg/mosADD-OS.git",
    "directory": "packages/mcp"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "mosadd-mcp": "./dist/bin/mcp.js",
    "mosadd": "./dist/bin/mcp.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin/mcp.ts src/bin/login.ts --format esm --dts --clean --shims",
    "dev": "tsx src/bin/mcp.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@mosadd/crypto": "workspace:*",
    "@mosadd/protocol": "workspace:*",
    "@mosadd/providers": "workspace:*",
    "@mosadd/threat-engine": "workspace:*",
    "@supabase/supabase-js": "^2.48.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "mosadd",
    "mcp",
    "model-context-protocol",
    "agent",
    "claude",
    "cursor",
    "anthropic",
    "communication",
    "messaging"
  ],
  "engines": {
    "node": ">=18"
  }
}
