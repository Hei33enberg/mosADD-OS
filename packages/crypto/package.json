{
  "name": "@mosadd/crypto",
  "version": "3.0.0-alpha.27",
  "description": "End-to-end cryptography for mosadd: X3DH key agreement, Double Ratchet, AES, HKDF, BIP39 mnemonic, secure vault.",
  "homepage": "https://github.com/Hei33enberg/mosadd-os/tree/main/packages/crypto",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hei33enberg/mosadd-os.git",
    "directory": "packages/crypto"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@noble/ciphers": "^2.1.1",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "mosadd",
    "crypto",
    "e2e",
    "x3dh",
    "double-ratchet",
    "signal-protocol"
  ],
  "engines": {
    "node": ">=18"
  }
}
