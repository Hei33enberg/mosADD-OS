{
  "mcpServers": {
    "mosadd": {
      "command": "npx",
      "args": ["-y", "github:Hei33enberg/mosadd-os", "--package=@mosadd/mcp"],
      "env": {
        "MOSADD_SUPABASE_URL": "https://<your-project>.supabase.co",
        "MOSADD_SUPABASE_ANON_KEY": "<your supabase anon key>",
        "MOSADD_USER_JWT": "<your session JWT — see README>"
      }
    }
  }
}
