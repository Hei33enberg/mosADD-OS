# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Environment
.env
.env.local
.env.*.local

# Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Test coverage
coverage/
*.lcov

# Temporary
.tmp/
.cache/
.turbo/

# OS
Thumbs.db
desktop.ini

# Local-only files
.local/

# Secrets (in case anything slips)
*.key
*.pem
*.p12
secrets/

# Generated docs
docs/api/

# Forks (vendored OSS — keep but ignore their dependencies)
forks/*/node_modules/
forks/*/dist/
forks/*/build/

# Local build / CLI artifacts (generated, never commit)
**/supabase/.temp/
apps/channel0-ext/*.zip
apps/dev/public/v1.js.map
# Vercel CLI pulls project config into a local .vercel/ on manual deploys — never commit it
**/.vercel/

# One-shot work scripts must not live next to publishable sources (2026-09-01).
# Measured: 11 packages/mcp/*.mjs files held live mosadd_sk_live_ keys in clear text.
# They were untracked, so they did not leak — but they sat in a commit-prone tree.
packages/mcp/*.mjs
!packages/mcp/scripts/*.mjs

# Generated agent build artifact — do not commit
packages/agent/dist-bundle/
# vendor-drop: verbatim mDM E2EE copy from private Hei33enberg/mosADD (CYMRU drop only).
# Do not publish proprietary product code into this public client repo.
vendor-drop/

# Local secrets
.env.local.txt
