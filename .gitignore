# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Environment
.env
.env.local
.env.*.local

# Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Test coverage
coverage/
*.lcov

# Temporary
.tmp/
.cache/
.turbo/

# OS
Thumbs.db
desktop.ini

# Local-only files
.local/

# Secrets (in case anything slips)
*.key
*.pem
*.p12
secrets/

# Generated docs
docs/api/

# Forks (vendored OSS — keep but ignore their dependencies)
forks/*/node_modules/
forks/*/dist/
forks/*/build/

# Local build / CLI artifacts (generated, never commit)
**/supabase/.temp/
apps/channel0-ext/*.zip
apps/dev/public/v1.js.map
# Vercel CLI pulls project config into a local .vercel/ on manual deploys — never commit it
**/.vercel/
