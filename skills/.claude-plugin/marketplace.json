{
  "name": "mosadd",
  "displayName": "mosadd — A human OS. Add.",
  "description": "Operating system for human communications. Encrypted direct messages with sealed sender, persistent channels, push-to-talk, email, a RAG knowledge base and a defensive threat-event classification engine — one MCP server. Open-source under Apache-2.0.",
  "version": "3.0.0-alpha.16",
  "author": {
    "name": "mosadd contributors",
    "url": "https://mosadd.com"
  },
  "homepage": "https://mosadd.com",
  "repository": "https://github.com/Hei33enberg/mosadd-os",
  "license": "Apache-2.0",
  "mcpServers": {
    "mosadd": {
      "command": "npx",
      "args": ["-y", "github:Hei33enberg/mosadd-os", "--package=@mosadd/mcp"],
      "env": {
        "MOSADD_SUPABASE_URL": "https://<your-project>.supabase.co",
        "MOSADD_SUPABASE_ANON_KEY": "<anon key>",
        "MOSADD_USER_JWT": "<your session token>"
      }
    }
  },
  "skills": [
    {
      "name": "mosadd-mdm",
      "path": "../mdm/SKILL.md"
    },
    {
      "name": "mosadd-mirc",
      "path": "../mirc/SKILL.md"
    },
    {
      "name": "mosadd-mail",
      "path": "../mail/SKILL.md"
    },
    {
      "name": "mosadd-mtalk",
      "path": "../mtalk/SKILL.md"
    },
    {
      "name": "mosadd-mrag",
      "path": "../mrag/SKILL.md"
    }
  ],
  "tags": [
    "communication",
    "messaging",
    "mcp",
    "agents",
    "claude",
    "cursor",
    "open-source",
    "apache-2"
  ]
}
