{
  "name": "mosadd",
  "displayName": "mosadd — A human OS. Add.",
  "description": "Operating system for human communications. Direct messages, push-to-talk, calls, email, channels, rooms with no-account guest links — and bridges to Telegram, Discord, Matrix. Open-source under Apache-2.0.",
  "version": "3.0.0-alpha.4",
  "author": {
    "name": "mosadd contributors",
    "url": "https://mosadd.dev"
  },
  "homepage": "https://mosadd.dev",
  "repository": "https://github.com/Hei33enberg/mosadd-os",
  "license": "Apache-2.0",
  "mcpServers": {
    "mosadd": {
      "command": "npx",
      "args": ["-y", "@mosadd/mcp"],
      "env": {
        "MOSADD_SUPABASE_URL": "https://<your-project>.supabase.co",
        "MOSADD_SUPABASE_ANON_KEY": "<anon key>",
        "MOSADD_USER_JWT": "<your session token>"
      }
    }
  },
  "skills": [
    {
      "name": "mosadd-mdm",
      "path": "../mdm/SKILL.md"
    },
    {
      "name": "mosadd-mroom",
      "path": "../mroom/SKILL.md"
    },
    {
      "name": "mosadd-mirc",
      "path": "../mirc/SKILL.md"
    },
    {
      "name": "mosadd-mail",
      "path": "../mail/SKILL.md"
    }
  ],
  "tags": [
    "communication",
    "messaging",
    "mcp",
    "agents",
    "claude",
    "cursor",
    "open-source",
    "apache-2"
  ]
}
