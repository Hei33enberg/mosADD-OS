{
  "name": "mosadd-os",
  "version": "3.0.0-alpha.4",
  "private": true,
  "description": "mosadd — the comms layer for AI agents, and the humans who direct them.",
  "homepage": "https://mosadd.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hei33enberg/mosadd-os.git"
  },
  "license": "Apache-2.0",
  "author": "mosadd contributors",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r --parallel run test",
    "typecheck": "pnpm -r --parallel run typecheck",
    "lint": "pnpm -r --parallel run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "clean": "pnpm -r --parallel run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@types/node": "^22.10.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "overrides": {
      "langsmith": ">=0.6.0",
      "hono": ">=4.12.25",
      "form-data": ">=4.0.6"
    }
  },
  "keywords": [
    "mosadd",
    "communication",
    "mcp",
    "agent",
    "claude",
    "cursor",
    "operating-system",
    "messaging",
    "ptt",
    "matrix",
    "discord",
    "telegram"
  ]
}
