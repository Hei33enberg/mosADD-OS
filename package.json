{
  "name": "mosadd-os",
  "private": true,
  "description": "m.0S client (MIT): installer and stdio shim, MCP tool definitions, SDK adapters, skills. The hosted service is not in this repository.",
  "homepage": "https://github.com/Hei33enberg/mosADD-OS",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hei33enberg/mosADD-OS.git"
  },
  "license": "MIT",
  "author": "mosadd contributors",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r --parallel run test",
    "typecheck": "pnpm -r --parallel run typecheck",
    "lint": "pnpm -r --parallel run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "clean": "pnpm -r --parallel run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@types/node": "^22.10.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "overrides": {
      "langsmith": ">=0.6.0",
      "hono": ">=4.12.25",
      "form-data": ">=4.0.6"
    }
  },
  "keywords": [
    "m0s",
    "mosadd",
    "mcp",
    "agent",
    "claude",
    "cursor",
    "codex",
    "messaging",
    "ptt"
  ]
}
